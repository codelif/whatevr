[Desktop Entry]
Type=Application
Name=Whatevr
Comment=Native WhatsApp client for Linux
Exec=whatkevr %u
Icon=in.codelif.Whatevr
Terminal=false
Categories=Network;Chat;InstantMessaging;Qt;KDE;
Keywords=WhatsApp;Messaging;Chat;
StartupNotify=true
# whatevr://chat/<id> deep links (used by notification clicks) are handled by
# whatkevr; single-instance routing is done via KDBusService.
MimeType=x-scheme-handler/whatevr;
