[Unit]
Description=whatevr daemon socket

[Socket]
# Must match the whatevr protocol socket the daemon and frontends use
# (PROTOCOL.md):
#   $XDG_RUNTIME_DIR/whatevr/whatevrd.sock   (%t = runtime dir for user units)
# systemd creates the parent directory and owns the socket; the daemon adopts
# the inherited fd via socket activation and never unlinks it.
ListenStream=%t/whatevr/whatevrd.sock
SocketMode=0600

[Install]
WantedBy=sockets.target
