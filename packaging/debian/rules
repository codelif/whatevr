#!/usr/bin/make -f
# Delegate build/install to the project's top-level Makefile (single source of
# truth). debhelper still handles stripping, shlibdeps, systemd units, etc.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# go-sqlite3 needs CGO; never disable it.
export CGO_ENABLED = 1
# Build environments are offline: require a local Go 1.25 toolchain.
export GOTOOLCHAIN = local

%:
	dh $@

override_dh_auto_configure:
	# configure happens inside `make build-frontend`

override_dh_auto_build:
	$(MAKE) build PREFIX=/usr

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/whatevr

override_dh_auto_test:
	# no test suite wired up yet
